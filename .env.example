# Copy this file to .env and fill in real values. Never commit .env — it's already
# in .gitignore. See README.md for step-by-step instructions on getting each value.

# ---------------------------------------------------------------------------
# Database (Prisma)
# ---------------------------------------------------------------------------
# Local development default (SQLite, a file on disk — good enough for one tradesman):
DATABASE_URL="file:./dev.db"
# For production on Vercel, switch prisma/schema.prisma's datasource provider to
# "postgresql" and set this to a free Neon (https://neon.tech) or Supabase
# (https://supabase.com) connection string instead, e.g.:
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Twilio (SMS notifications) — https://www.twilio.com/try-twilio
# ---------------------------------------------------------------------------
# Account SID and Auth Token: Twilio Console dashboard (console.twilio.com), top of the page.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# A Twilio phone number capable of sending SMS, in E.164 format (e.g. +441234567890).
# Buy one under Phone Numbers > Buy a number in the Twilio Console (trial accounts get one free).
TWILIO_FROM_NUMBER=""

# Harpreet's own mobile number, used as the destination for booking-alert SMS.
# Any normal UK format works, e.g. "07857 873515".
OWNER_PHONE="07857873515"

# ---------------------------------------------------------------------------
# Google Calendar API (refresh-token flow, single calendar)
# ---------------------------------------------------------------------------
# 1. Go to https://console.cloud.google.com/ and create a new project.
# 2. Enable the "Google Calendar API" under APIs & Services > Library.
# 3. Under APIs & Services > OAuth consent screen, configure an "External" app
#    (or "Internal" if using a Google Workspace account) with your email as a test user.
# 4. Under APIs & Services > Credentials, create an "OAuth client ID" of type
#    "Web application" and add "https://developers.google.com/oauthplayground"
#    as an authorized redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# 5. Go to https://developers.google.com/oauthplayground
#    - Click the gear icon (top right) and check "Use your own OAuth credentials",
#      then paste the client ID/secret from step 4.
#    - In the left panel, find "Calendar API v3" and select the
#      "https://www.googleapis.com/auth/calendar" scope, then click "Authorize APIs".
#    - Sign in with the Google account whose calendar bookings should appear on.
#    - Click "Exchange authorization code for tokens" and copy the "Refresh token" value.
GOOGLE_REFRESH_TOKEN=""
# The calendar to add events to. Use "primary" for the signed-in account's main
# calendar, or a specific calendar's ID (Calendar Settings > Integrate calendar > Calendar ID).
GOOGLE_CALENDAR_ID="primary"

# ---------------------------------------------------------------------------
# Email (booking + enquiry notifications, sent via Gmail SMTP)
# ---------------------------------------------------------------------------
# The Gmail address that sends the notification emails. Needs 2-Step Verification
# turned on, then an App Password generated for it — see README.md for the exact
# steps. Do NOT use the account's normal login password here, it won't work.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Where booking and enquiry notifications should be delivered.
OWNER_EMAIL="you@example.com"

# ---------------------------------------------------------------------------
# Google Analytics 4 (optional)
# ---------------------------------------------------------------------------
# The GA4 Measurement ID from Admin > Data Streams > (your stream) in Google
# Analytics, format G-XXXXXXXXXX. Leave blank to skip analytics entirely — the
# site works fine without it. Must be prefixed NEXT_PUBLIC_ since it's read in
# the browser, not just on the server.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ---------------------------------------------------------------------------
# Admin page
# ---------------------------------------------------------------------------
# The password for the /admin bookings dashboard. Pick something only Harpreet
# (and you) know — this is the only login the admin page uses.
ADMIN_PASSWORD="change-me"
