// Prisma schema for Harpreet Singh Plumbing & Heating
//
// Uses Postgres (Neon) so bookings persist across Vercel's serverless
// deployments — Vercel's filesystem is read-only/ephemeral, so SQLite would
// lose all data between deploys or invocations. DATABASE_URL is the Neon
// connection string, set in .env locally and in Vercel's Environment
// Variables for production. See README.md for full instructions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id          String   @id @default(cuid())
  name        String
  phone       String
  email       String?
  jobType     String
  preferredAt String
  description String?
  status      String   @default("new") // new | confirmed | cancelled
  smsSent     Boolean  @default(false)
  calendarEventId String?
  createdAt   DateTime @default(now())
}

model Enquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now())
}
